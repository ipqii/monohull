<?xml version="1.0" encoding="UTF-8"?>
<server description="Maximo JMS — embedded Liberty messaging engine (Monohull configDropins overlay)">

	<!--
	  Embedded SIBus / Liberty messaging engine. Keeps the JNDI names that
	  stock Manage MAXQUEUE rows point at (jms/maximo/int/cf/intcf and
	  jms/maximo/int/queues/*) so they resolve without an external IBM MQ
	  broker.

	  Written to configDropins/overrides/ (issue #7): Liberty loads dropins
	  for EVERY server.xml flavor. IBM's standard server.xml only includes
	  /config/manage/serverxml/server-custom.xml and the dev flavor includes
	  a relative server-custom.xml — targeting either path breaks on the
	  other flavor, and editing server.xml itself is undone by any restore
	  from the config-servers template. featureManager merges across config
	  sources, so the wasJmsServer feature rides in this same file.

	  Queue set mirrors all 9 rows stock Manage 9.x ships in MAXQUEUE.
	-->

	<featureManager>
		<feature>wasJmsServer-1.0</feature>
	</featureManager>

	<messagingEngine>
		<queue id="sqout" maxQueueDepth="100000"/>
		<queue id="sqin" maxQueueDepth="100000"/>
		<queue id="cqin" maxQueueDepth="100000"/>
		<queue id="cqinerr" maxQueueDepth="100000"/>
		<queue id="cqout" maxQueueDepth="100000"/>
		<queue id="cqouterr" maxQueueDepth="100000"/>
		<queue id="notf" maxQueueDepth="100000"/>
		<queue id="notferr" maxQueueDepth="100000"/>
		<queue id="weather" maxQueueDepth="100000"/>
	</messagingEngine>

	<jmsQueueConnectionFactory jndiName="jms/maximo/int/cf/intcf" connectionManagerRef="MIFJMS">
		<properties.wasJms/>
	</jmsQueueConnectionFactory>
	<connectionManager id="MIFJMS" maxPoolSize="20"/>

	<jmsQueue jndiName="jms/maximo/int/queues/sqout">
		<properties.wasJms queueName="sqout"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/sqin">
		<properties.wasJms queueName="sqin"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/cqin">
		<properties.wasJms queueName="cqin"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/cqinerr">
		<properties.wasJms queueName="cqinerr"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/cqout">
		<properties.wasJms queueName="cqout"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/cqouterr">
		<properties.wasJms queueName="cqouterr"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/notf">
		<properties.wasJms queueName="notf"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/notferr">
		<properties.wasJms queueName="notferr"/>
	</jmsQueue>
	<jmsQueue jndiName="jms/maximo/int/queues/weather">
		<properties.wasJms queueName="weather"/>
	</jmsQueue>

</server>
